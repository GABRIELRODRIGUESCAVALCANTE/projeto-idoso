PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ========================================================
# PROVEDOR DE INTELIGÊNCIA ARTIFICIAL (ARQUITETURA HÍBRIDA)
# ========================================================
# Opções para AI_PROVIDER:
#  - "gemini": Utiliza Google Gemini na nuvem (Rápido, ideal para faculdade e VPS sem GPU)
#  - "local":  Utiliza Qwen localmente via Ollama ou LM Studio (Sem limite de cota)
#  - "auto":   Tenta o Qwen local se estiver rodando; se estiver offline, usa o Gemini automaticamente
AI_PROVIDER=gemini

# --- Configuração Google Gemini (Nuvem) ---
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=sua_chave_da_api_gemini_aqui

# --- Configuração Modelo Local (Qwen / Ollama / LM Studio) ---
# URL do servidor local de inferência (Padrão Ollama: http://127.0.0.1:11434 | LM Studio: http://127.0.0.1:1234)
LOCAL_AI_URL=http://127.0.0.1:11434
# Nome do modelo com visão multimodal instalado (ex: qwen2.5-vl:3b, qwen2-vl:2b, qwen2.5-vl:7b)
LOCAL_AI_MODEL=qwen2.5-vl:3b
# Tempo limite para resposta local em milissegundos (default: 180000 = 3 minutos)
LOCAL_AI_TIMEOUT=180000
